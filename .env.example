# Local DuckDB: no Snowflake or Kafka required.
# The one-click launcher detects a sibling Daedalus checkout on first use.
# If it cannot find one, it uses ./output/market_data.
IKAROS_DB_DRIVER=duckdb
IKAROS_MARKET_DATA_DIR=./output/market_data
# To share with Daedalus, use its actual directory, for example:
# IKAROS_MARKET_DATA_DIR=../daedalus/input/market_data
# Optional cloud backend:
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
# IKAROS_KAFKA_BROKERS=127.0.0.1:9092
