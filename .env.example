# Copy this file to .env and fill in your own secrets.
# Never commit .env, access tokens, or actual account credentials.
# Values with #, spaces, or special characters should be in double quotes.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# Optional overrides. Keep 127.0.0.1 for local Docker Compose Kafka.
IKAROS_KAFKA_BROKERS=127.0.0.1:9092
