# Ikaros quick start: local DuckDB, no Snowflake account or Kafka required.
# Copy to .env and adjust the market-data directory if needed.
IKAROS_DB_DRIVER=duckdb
IKAROS_MARKET_DATA_DIR=./output/market_data

# For Daedalus, point the directory to its input/market_data directory, e.g.:
# IKAROS_MARKET_DATA_DIR=C:/projects_AK/Daedalus/input/market_data

# Optional cloud backend: set IKAROS_DB_DRIVER=snowflake and configure
# your Snowflake account/authentication. Never commit actual credentials.
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

# Optional Kafka (not needed for daily/backfill DuckDB imports):
# IKAROS_KAFKA_BROKERS=127.0.0.1:9092
